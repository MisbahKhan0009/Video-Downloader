{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vidra",
  "version": "0.2.1",
  "identifier": "com.misbahkhan.vidra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Vidra",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Grab videos from links and paginated pages",
    "longDescription": "Vidra detects whether a link is a video or a page, scans pages (including paginated lists and linked video pages) for every video, and downloads them with pause, resume and HLS support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
